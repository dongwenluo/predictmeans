Package: predictmeans
Version: 2.0.0
Authors@R: c(person("Dongwen", "Luo", role = c("aut", "cre"),
                    email = "dongwen.luo@agresearch.co.nz"),
             person("Siva", "Ganesh", role = "aut"),
             person("John", "Koolaard", role = "aut"),
