:

" plots as a factor for the nugget (independent plot error) "
FACTOR [LEVELS=150; VALUES=1...150] units

" ---- A: AR1 x AR1 ---- "
VCOMPONENTS [FIXED=variety] RANDOM=fieldrow.fieldcolumn
VSTRUCTURE [fieldrow.fieldcolumn] AR,AR; FACTOR=fieldrow,fieldcolumn; ORDER=1,1
REML [PRINT=model,components,deviance,wald] yield
VPREDICT [PRINT=*; PREDICTIONS=mA; SED=sA] CLASSIFY=variety
PRINT mA; FIELDWIDTH=16; DECIMALS=8
PRINT sA; FIELDWIDTH=12; DECIMALS=8

" ---- B: AR1 x AR1 + nugget ---- "
VCOMPONENTS [FIXED=variety] RANDOM=units + fieldrow.fieldcolumn
VSTRUCTURE [fieldrow.fieldcolumn] AR,AR; FACTOR=fieldrow,fieldcolumn; ORDER=1,1
REML [PRINT=model,components,deviance,wald] yield
VPREDICT [PRINT=*; PREDICTIONS=mB; SED=sB] CLASSIFY=variety
PRINT mB; FIELDWIDTH=16; DECIMALS=8
PRINT sB; FIELDWIDTH=12; DECIMALS=8

" ---- C: replicates random + AR1 x AR1 ---- "
VCOMPONENTS [FIXED=variety] RANDOM=replicates + fieldrow.fieldcolumn
VSTRUCTURE [fieldrow.fieldcolumn] AR,AR; FACTOR=fieldrow,fieldcolumn; ORDER=1,1
REML [PRINT=model,components,deviance,wald] yield
VPREDICT [PRINT=*; PREDICTIONS=mC; SED=sC] CLASSIFY=variety
PRINT mC; FIELDWIDTH=16; DECIMALS=8
PRINT sC; FIELDWIDTH=12; DECIMALS=8

" ---- D: replicates random + nugget + AR1 x AR1 ---- "
VCOMPONENTS [FIXED=variety] RANDOM=replicates + units + fieldrow.fieldcolumn
VSTRUCTURE [fieldrow.fieldcolumn] AR,AR; FACTOR=fieldrow,fieldcolumn; ORDER=1,1
REML [PRINT=model,components,deviance,wald] yield
VPREDICT [PRINT=*; PREDICTIONS=mD; SED=sD] CLASSIFY=variety
PRINT mD; FIELDWIDTH=16; DECIMALS=8
PRINT sD; FIELDWIDTH=12; DECIMALS=8
