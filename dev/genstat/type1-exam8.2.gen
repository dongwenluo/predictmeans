\ ---- Run 1: as SAS, repl + column + contcompf + contcompf.standard ----
VCOMPONENTS [FIXED=repl + column + contcompf + contcompf.standard; CADJUST=none] \
  RANDOM=repl.row + repl.column + contcompv.clone
REML [PRINT=model, components, waldtests, means; PTERMS=contcompf.standard; \
  METHOD=AI] dbh

\ ---- Run 2: another order, contcompf + repl + column + contcompf.standard ----
VCOMPONENTS [FIXED=contcompf + repl + column + contcompf.standard; CADJUST=none] \
  RANDOM=repl.row + repl.column + contcompv.clone
REML [PRINT=model, components, waldtests; METHOD=AI] dbh
