:
GROUPS tsite; FACTOR=site
GROUPS tlot;  FACTOR=seedlot

\ (1) raw site means
TABULATE [CLASSIFICATION=site] ht; MEANS=rawmean
VARIATE [NVALUES=6] rawv; VALUES=rawmean
CALCULATE sitemean = NEWLEVELS(site; rawv)

\ (2) site means adjusted for seedlot (additive model; book Table 5.9)
MODEL ht
FIT [PRINT=*] site + seedlot
PREDICT [PRINT=prediction,se; PREDICTIONS=adjmean] site
VARIATE [NVALUES=6] adjv; VALUES=adjmean
CALCULATE sitemean_adj = NEWLEVELS(site; adjv)

\ Seedlot means: equal weights over sites, then marginal (observed) weights
FOR cov = sitemean, sitemean_adj
  FIT [PRINT=accumulated,estimates; FPROB=yes] site + cov*seedlot
  PREDICT [PRINT=prediction,se; COMBINATIONS=estimable; ADJUST=equal] seedlot
  PREDICT [PRINT=prediction,se; COMBINATIONS=present; ADJUST=marginal] seedlot
ENDFOR
STOP
